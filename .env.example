# Configuración local de desarrollo. Vite NO interviene aquí: este servicio lee
# process.env directamente (no hay dotenv cargado en runtime). Los valores
# reales viven en k8s como secretos (audit-db / audit-rabbitmq), que el CI
# crea descifrando config/secrets.production.enc con sops.

# Base de datos (idempotencia + bitácora)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=audit_db

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672

# API
PORT=3012
CORS_ORIGIN=http://localhost:5173

# Retención: días que se conservan las filas. 0 = para siempre (default).
# Con un valor > 0 se purga a diario lo anterior a esa ventana.
AUDIT_RETENTION_DAYS=0